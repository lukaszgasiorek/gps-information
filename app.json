{
  "expo": {
    "name": "GPS Locator",
    "slug": "gps-locator",
    "version": "1.0.0",
    "orientation": "portrait",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.yourname.gpslocator"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikacja potrzebuje dostępu do GPS aby pobrać Twoje współrzędne."
        }
      ]
    ]
  }
}
